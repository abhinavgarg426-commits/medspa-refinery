{
  "$schema": "https://llms.json/schemas/llms.json",
  "version": "1.0",
  "name": "Miami MedSpa Data Refinery",
  "description": "Machine-readable structured database of local aesthetic clinics, pricing, services, and AI visibility readiness scores in Miami, FL. Powered by x402 HTTP 402 micropayments for autonomous AI agent access.",
  "homepage": "https://medspa-refinery-api-44xz.onrender.com",
  "repository": "https://github.com/abhinavgarg426-commits/medspa-refinery",
  "documentation": "https://medspa-refinery-api-44xz.onrender.com/llms.txt",
  "fullDump": "https://medspa-refinery-api-44xz.onrender.com/llms-full.txt",
  "contact": {
    "email": "api@medspa-refinery.example.com",
    "twitter": "@medsparefinery"
  },
  "license": "MIT",
  "payment": {
    "protocol": "x402",
    "version": "1.0",
    "network": "base",
    "chainId": 8453,
    "currency": "USDC",
    "payToAddress": "0x8Ae639d10b23Eb630241d7fD6275255a2e51Ec95",
    "pricePerRequestUsd": 0.002,
    "priceUnits": 2000,
    "scheme": "exact"
  },
  "endpoints": [
    {
      "name": "List Clinics",
      "path": "/api/v1/clinics",
      "method": "GET",
      "description": "Returns full list of medspas with location, rating, and AI visibility score. Supports optional city filter.",
      "costUsd": 0.002,
      "paymentRequired": true,
      "parameters": [
        {
          "name": "city",
          "type": "string",
          "required": false,
          "description": "Filter clinics by city (e.g., miami)"
        }
      ],
      "responseSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "count": { "type": "integer" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "city": { "type": "string" },
                "state": { "type": "string" },
                "address": { "type": "string" },
                "phone": { "type": "string" },
                "website": { "type": "string" },
                "rating": { "type": "number" },
                "reviews_count": { "type": "integer" },
                "ai_visibility_score": { "type": "integer" },
                "last_updated": { "type": "string" },
                "services": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": { "type": "string" },
                      "item": { "type": "string" },
                      "price_usd": { "type": "number" },
                      "unit": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "payment_receipt": {
            "type": "object",
            "properties": {
              "settled": { "type": "boolean" },
              "cost_usd": { "type": "number" },
              "protocol": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "name": "Get Clinic by ID",
      "path": "/api/v1/clinics/{clinic_id}",
      "method": "GET",
      "description": "Returns specific clinic info and itemized pricing list (Botox, fillers, lasers, weight loss).",
      "costUsd": 0.002,
      "paymentRequired": true,
      "parameters": [
        {
          "name": "clinic_id",
          "type": "integer",
          "required": true,
          "description": "Unique clinic identifier"
        }
      ],
      "responseSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "data": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "city": { "type": "string" },
              "state": { "type": "string" },
              "address": { "type": "string" },
              "phone": { "type": "string" },
              "website": { "type": "string" },
              "rating": { "type": "number" },
              "reviews_count": { "type": "integer" },
              "ai_visibility_score": { "type": "integer" },
              "last_updated": { "type": "string" },
              "services": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": { "type": "string" },
                    "item": { "type": "string" },
                    "price_usd": { "type": "number" },
                    "unit": { "type": "string" }
                  }
                }
              }
            }
          },
          "payment_receipt": {
            "type": "object",
            "properties": {
              "settled": { "type": "boolean" },
              "cost_usd": { "type": "number" },
              "protocol": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "name": "Search Treatments",
      "path": "/api/v1/search",
      "method": "GET",
      "description": "Query clinics offering specific treatments and compare prices across Miami. Supports 'treatment' or 'service' query parameters.",
      "costUsd": 0.002,
      "paymentRequired": true,
      "parameters": [
        {
          "name": "treatment",
          "type": "string",
          "required": true,
          "description": "Treatment name to search for (e.g., botox, fillers, laser)"
        },
        {
          "name": "service",
          "type": "string",
          "required": false,
          "description": "Alias for treatment parameter"
        }
      ],
      "responseSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "query": { "type": "string" },
          "matches_count": { "type": "integer" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "city": { "type": "string" },
                "state": { "type": "string" },
                "address": { "type": "string" },
                "phone": { "type": "string" },
                "website": { "type": "string" },
                "rating": { "type": "number" },
                "reviews_count": { "type": "integer" },
                "ai_visibility_score": { "type": "integer" },
                "last_updated": { "type": "string" },
                "matching_services": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": { "type": "string" },
                      "item": { "type": "string" },
                      "price_usd": { "type": "number" },
                      "unit": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "publicEndpoints": [
    {
      "name": "Health Check",
      "path": "/health",
      "method": "GET",
      "description": "Health check endpoint for monitoring. No payment required."
    },
    {
      "name": "LLM Index (Text)",
      "path": "/llms.txt",
      "method": "GET",
      "description": "Machine-readable index for AI crawlers. No payment required."
    },
    {
      "name": "LLM Full Dump (Text)",
      "path": "/llms-full.txt",
      "method": "GET",
      "description": "Full plain-text dataset dump for context window ingestion. No payment required."
    },
    {
      "name": "LLM Index (JSON)",
      "path": "/llms.json",
      "method": "GET",
      "description": "Machine-readable JSON manifest for AI agent discovery. No payment required."
    },
    {
      "name": "API Documentation",
      "path": "/docs",
      "method": "GET",
      "description": "Interactive OpenAPI/Swagger documentation. No payment required."
    }
  ],
  "examples": {
    "curl": {
      "description": "Query botox pricing with mock payment header (for testing)",
      "command": "curl -H \"X-Mock-Payment-Paid: true\" \"https://medspa-refinery-api-44xz.onrender.com/api/v1/search?treatment=botox\""
    },
    "x402_flow": {
      "description": "Standard x402 payment flow for autonomous agents",
      "steps": [
        "GET /api/v1/search?treatment=botox",
        "Receive 402 with PAYMENT-REQUIRED header (base64 x402 spec)",
        "Decode spec, sign USDC transfer on Base (chain 8453) to pay_to address",
        "Retry request with PAYMENT-SIGNATURE header containing tx hash",
        "Receive 200 with data + payment_receipt"
      ]
    }
  },
  "tags": [
    "medspa",
    "aesthetic",
    "clinic",
    "pricing",
    "miami",
    "x402",
    "http-402",
    "micropayments",
    "agent-economy",
    "ai-readiness",
    "structured-data"
  ]
}
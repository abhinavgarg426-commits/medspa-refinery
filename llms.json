{
  "$schema": "https://llms.json/schemas/llms.json",
  "version": "2.0.0",
  "name": "Universal Agent Knowledge Graph API (\"Google for AI Agents\")",
  "description": "Structured, queryable discovery engine and knowledge graph for 200+ local venues across cafes, restaurants, hotels, and medspas in Miami, FL. Powered by x402 HTTP 402 micropayments for autonomous AI agent access.",
  "homepage": "https://medspa-refinery-api-44xz.onrender.com",
  "repository": "https://github.com/abhinavgarg426-commits/medspa-refinery",
  "documentation": "https://medspa-refinery-api-44xz.onrender.com/llms.txt",
  "fullDump": "https://medspa-refinery-api-44xz.onrender.com/llms-full.txt",
  "contact": {
    "email": "agent-browser@example.com",
    "twitter": "@agentbrowser"
  },
  "license": "MIT",
  "payment": {
    "protocol": "x402",
    "version": "1.0",
    "network": "base",
    "chainId": 8453,
    "currency": "USDC",
    "payToAddress": "0x8Ae639d10b23Eb630241d7fD6275255a2e51Ec95",
    "priceStandardUsd": 0.002,
    "priceRecommendUsd": 0.005,
    "scheme": "exact"
  },
  "categories": ["cafe", "restaurant", "hotel", "medspa"],
  "endpoints": [
    {
      "name": "Universal Intent Search",
      "path": "/api/v1/search",
      "method": "GET",
      "description": "Multi-category intent search across cafes, restaurants, hotels, and medspas. Accepts natural language queries (e.g., 'wifi cafes in Wynwood') or structured filter parameters.",
      "costUsd": 0.002,
      "paymentRequired": true,
      "parameters": [
        { "name": "query", "type": "string", "required": false, "description": "Natural language query or keywords" },
        { "name": "category", "type": "string", "required": false, "description": "Filter by venue category: cafe, restaurant, hotel, medspa" },
        { "name": "neighborhood", "type": "string", "required": false, "description": "Filter by Miami area (e.g., Wynwood, Brickell, South Beach)" },
        { "name": "min_rating", "type": "number", "required": false, "description": "Minimum overall rating (1.0 - 5.0)" },
        { "name": "max_price_level", "type": "string", "required": false, "description": "Maximum price level: $, $$, $$$, $$$$" },
        { "name": "limit", "type": "integer", "required": false, "default": 10, "description": "Maximum results to return" }
      ],
      "responseSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "query": { "type": "string" },
          "classified_intent": { "type": "string" },
          "matches_count": { "type": "integer" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "category": { "type": "string" },
                "sub_category": { "type": "string" },
                "address": { "type": "string" },
                "neighborhood": { "type": "string" },
                "price_level": { "type": "string" },
                "overall_rating": { "type": "number" },
                "safety_score": { "type": "number" },
                "value_score": { "type": "number" },
                "ambiance_score": { "type": "number" },
                "service_score": { "type": "number" },
                "sentiment_tags": { "type": "array", "items": { "type": "string" } },
                "agent_match_index": { "type": "number" },
                "_rationale": { "type": "string" }
              }
            }
          },
          "payment_receipt": { "type": "object" }
        }
      }
    },
    {
      "name": "Agent Recommendation Engine",
      "path": "/api/v1/recommend",
      "method": "POST",
      "description": "Multi-category recommendation engine that processes agent intent payloads and returns ranked matches scored by Agent Match Index (0-100) with detailed rationale.",
      "costUsd": 0.005,
      "paymentRequired": true,
      "requestBodySchema": {
        "type": "object",
        "required": ["category"],
        "properties": {
          "category": { "type": "string", "description": "cafe, restaurant, hotel, medspa" },
          "preferred_area": { "type": "string", "description": "Neighborhood preference" },
          "required_features": { "type": "array", "items": { "type": "string" }, "description": "e.g., ['fast_wifi', 'outdoor_seating', 'parking']" },
          "max_price_level": { "type": "string", "description": "$, $$, $$$, $$$$" },
          "min_rating": { "type": "number", "description": "Minimum overall rating" },
          "limit": { "type": "integer", "default": 5 }
        }
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "intent_payload": { "type": "object" },
          "recommendations_count": { "type": "integer" },
          "data": { "type": "array" },
          "payment_receipt": { "type": "object" }
        }
      }
    },
    {
      "name": "List Venues",
      "path": "/api/v1/venues",
      "method": "GET",
      "description": "List and filter venues by category, neighborhood, rating.",
      "costUsd": 0.002,
      "paymentRequired": true,
      "parameters": [
        { "name": "category", "type": "string" },
        { "name": "neighborhood", "type": "string" },
        { "name": "min_rating", "type": "number" },
        { "name": "limit", "type": "integer", "default": 20 }
      ]
    },
    {
      "name": "Get Venue Details",
      "path": "/api/v1/venues/{venue_id}",
      "method": "GET",
      "description": "Detailed venue information including all catalog offerings, pricing, scores, and sentiment tags.",
      "costUsd": 0.002,
      "paymentRequired": true,
      "parameters": [
        { "name": "venue_id", "type": "integer", "required": true }
      ]
    },
    {
      "name": "Pricing Analytics Summary",
      "path": "/api/v1/analytics/pricing-summary",
      "method": "GET",
      "description": "Category-specific price analytics across all offerings (average, min, max, spread).",
      "costUsd": 0.002,
      "paymentRequired": true,
      "parameters": [
        { "name": "category", "type": "string", "required": false, "description": "cafe, restaurant, hotel, medspa" }
      ]
    }
  ],
  "publicEndpoints": [
    { "name": "Health Check", "path": "/health", "method": "GET" },
    { "name": "LLM Index (Text)", "path": "/llms.txt", "method": "GET" },
    { "name": "LLM Full Dump (Text)", "path": "/llms-full.txt", "method": "GET" },
    { "name": "LLM Index (JSON)", "path": "/llms.json", "method": "GET" },
    { "name": "API Documentation", "path": "/docs", "method": "GET" }
  ],
  "tags": [
    "agent-browser",
    "google-for-agents",
    "knowledge-graph",
    "x402",
    "http-402",
    "agent-economy",
    "cafes",
    "restaurants",
    "hotels",
    "medspas",
    "miami",
    "pricing-analytics"
  ]
}
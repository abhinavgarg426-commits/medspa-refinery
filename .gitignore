# Git Ignore for Miami MedSpa Data Refinery
# Prevents sensitive/derived files from being committed

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment & secrets
.env
.env.*
.env.local
.env.production
.env.staging
*.env
*.key
*.pem
*.p12
*.pfx
secrets.yaml
secrets.yml

# Logs & temp
*.log
logs/
*.tmp
*.temp
temp/
tmp/
*.pid
*.lock

# Database (local copy - production uses persistent disk)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS
Desktop.ini

# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/

# Build artifacts
dist/
build/
*.tar.gz
*.whl

# Docker
.docker/

# Cloudflare Workers
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Generated packages (re-generated on demand)
ai_site_packages/

# MCP / runtime
*.pid
*.sock

# Backup files
*.bak
*.backup
*.old
*.orig